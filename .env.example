# Optional local dependency overrides for coordinated plugin development.
# Leave these unset to fetch the plugins from GitHub through CPM.
UNPACKER_DATA_PRODUCTS_SAMPIC_SOURCE=/path/to/unpacker_data_products_sampic
UNPACKER_STAGES_SAMPIC_SOURCE=/path/to/unpacker_stages_sampic

# ROOT dictionary generation can be memory intensive.
UNPACKER_BUILD_JOBS=2
