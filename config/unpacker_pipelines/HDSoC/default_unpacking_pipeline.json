{
  "plugin_libraries": [
    "build/lib/libmidas_event_unpacker_plugin.so",
    "build/lib/libunpacker_data_products_core.so",
    "build/lib/libunpacker_data_products_nalu.so",
    "build/lib/libunpacker_stages_core.so",
    "build/lib/libunpacker_stages_nalu.so"
  ],
  "pipeline": [
    {
      "id": "event_to_byte_stream",
      "type": "MidasEventToByteStreamStage",
      "parameters": {
        "metadata_product_name": "event_metadata",
        "bank_product_name_prefix": "bytestream_bank_"
      },
      "next": [
        "unpack_HD00",
        "unpack_HT00",
        "unpack_HB00",
        "unpack_HC00",
        "unpack_HS00"
      ]
    },
    {
      "id": "unpack_HD00",
      "type": "ByteStreamToNaluEventStage",
      "parameters": {
        "input_byte_stream_product_name": "bytestream_bank_HD00",
        "output_product_name": "NaluEvent"
      },
      "next": [
        "cleanup_bytestream"
      ]
    },
    {
      "id": "unpack_HT00",
      "type": "ByteStreamToNaluTimeStage",
      "parameters": {
        "input_byte_stream_product_name": "bytestream_bank_HT00",
        "output_product_name": "NaluTime"
      },
      "next": [
        "cleanup_bytestream"
      ]
    },
    {
      "id": "unpack_HB00",
      "type": "ByteStreamToNaluBuilderEventStage",
      "parameters": {
        "input_byte_stream_product_name": "bytestream_bank_HB00",
        "output_product_name": "NaluBuilderEvent"
      },
      "next": [
        "cleanup_bytestream"
      ]
    },
    {
      "id": "unpack_HC00",
      "type": "ByteStreamToNaluCollectionTimingStage",
      "parameters": {
        "input_byte_stream_product_name": "bytestream_bank_HC00",
        "output_product_name": "NaluCollectionTiming"
      },
      "next": [
        "cleanup_bytestream"
      ]
    },
    {
      "id": "unpack_HS00",
      "type": "ByteStreamToNaluSelectionSummaryStage",
      "parameters": {
        "input_byte_stream_product_name": "bytestream_bank_HS00",
        "output_product_name": "NaluSelectionSummary"
      },
      "next": [
        "cleanup_bytestream"
      ]
    },
    {
      "id": "cleanup_bytestream",
      "type": "ClearProductsStage",
      "parameters": {
        "tags": [
          "built_by_midas_event_to_bytestream_stage",
          "byte_stream"
        ]
      },
      "next": []
    }
  ]
}
